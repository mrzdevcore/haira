{
  "Provider Declaration": {
    "prefix": "provider",
    "body": [
      "provider ${1:name} {",
      "\ttype: \"${2|openai,azure_openai,anthropic,google|}\"",
      "\tmodel: \"${3:gpt-4o}\"",
      "\tapi_key: env(\"${4:API_KEY}\")",
      "}"
    ],
    "description": "Declare an LLM provider"
  },
  "Agent Declaration": {
    "prefix": "agent",
    "body": [
      "agent ${1:Name} {",
      "\tprovider: ${2:provider_name}",
      "\tsystem: \"\"\"",
      "\t\t${3:You are a helpful assistant.}",
      "\t\"\"\"",
      "\ttools: [${4}]",
      "}"
    ],
    "description": "Declare an AI agent"
  },
  "Agent with Scope": {
    "prefix": "agent-scoped",
    "body": [
      "agent ${1:Name} {",
      "\tprovider: ${2:provider_name}",
      "\tscope: \"\"\"",
      "\t\t${3:Topic restrictions}",
      "\t\"\"\"",
      "\tscope_deny: \"\"\"",
      "\t\t${4:I can only help with topics within my scope.}",
      "\t\"\"\"",
      "\tsystem: \"\"\"",
      "\t\t${5:You are a helpful assistant.}",
      "\t\"\"\"",
      "\ttools: [${6}]",
      "}"
    ],
    "description": "Declare an AI agent with topic guardrails"
  },
  "Tool Declaration": {
    "prefix": "tool",
    "body": [
      "tool ${1:name}(${2:param}: ${3:string}) -> ${4:string} {",
      "\t\"\"\"${5:Description of what the tool does}\"\"\"",
      "\t${0}",
      "}"
    ],
    "description": "Declare a tool for agents"
  },
  "Workflow Declaration": {
    "prefix": "workflow",
    "body": [
      "@${1|http,webhook,cron,mcp|}",
      "workflow ${2:Name}(${3:params}) -> ${4:string} {",
      "\tstep \"${5:Step 1}\" {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Declare a workflow with trigger"
  },
  "Streaming Workflow": {
    "prefix": "workflow-stream",
    "body": [
      "@${1|http,webhook|}",
      "workflow ${2:Name}(${3:params}) -> stream {",
      "\tstep \"${4:Process}\" {",
      "\t\tresult, err = ${5:agent}.stream(${6:input})",
      "\t}",
      "}"
    ],
    "description": "Declare a streaming workflow"
  },
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:string} {",
      "\t${0}",
      "}"
    ],
    "description": "Define a function"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:string}",
      "}"
    ],
    "description": "Define a struct type"
  },
  "Step Block": {
    "prefix": "step",
    "body": [
      "step \"${1:Step Name}\" {",
      "\t${0}",
      "}"
    ],
    "description": "Add a workflow step"
  },
  "Step with Error Handling": {
    "prefix": "step-err",
    "body": [
      "step \"${1:Step Name}\" {",
      "\t${0}",
      "\tonerror {",
      "\t\t${2:// handle error}",
      "\t}",
      "}"
    ],
    "description": "Add a workflow step with error handling"
  },
  "Try-Catch Block": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1}",
      "} catch err {",
      "\t${2:io.println(err)}",
      "}"
    ],
    "description": "Try-catch error handling"
  },
  "For-In Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:list} {",
      "\t${0}",
      "}"
    ],
    "description": "For-in loop"
  },
  "Match Expression": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:pattern} => ${3:result}",
      "}"
    ],
    "description": "Match expression"
  },
  "Import Statement": {
    "prefix": "import",
    "body": "import \"${1:module}\"",
    "description": "Import a module"
  },
  "Import Selective": {
    "prefix": "import-from",
    "body": "import { ${1:Name} } from \"${2:module}\"",
    "description": "Import specific items from a module"
  },
  "Spawn Block": {
    "prefix": "spawn",
    "body": [
      "spawn {",
      "\t${1:task1}",
      "\t${2:task2}",
      "}"
    ],
    "description": "Parallel execution block"
  },
  "Test Declaration": {
    "prefix": "test",
    "body": [
      "test \"${1:description}\" {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a test"
  }
}
