// Example 13: Error Handling — multi-return errors and try/catch
import "io"
import "conv"

fn divide(a: int, b: int) -> int {
    if b == 0 {
        io.println("Error: division by zero")
        return 0
    }
    return a / b
}

fn main() {
    // Basic error guard
    io.println(divide(10, 3))
    io.println(divide(10, 0))

    // Multi-return error pattern: (value, error)
    n, err = conv.string_to_int("42")
    if err != nil {
        io.println("parse failed")
    } else {
        io.println(n)
    }

    // Handling parse errors gracefully
    val, err = conv.string_to_int("not_a_number")
    if err != nil {
        io.println("Expected error: could not parse")
    } else {
        io.println(val)
    }
}
