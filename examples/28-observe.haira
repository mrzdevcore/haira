// Observability showcase — demonstrates token usage, cost monitoring,
// optional Langfuse export, and the observe dashboard.
// Requires: OPENAI_API_KEY environment variable.
// Optional Langfuse: set LANGFUSE_HOST, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY
// Run: haira run examples/28-observe.haira

import "io"
import "http"
import "observe"
import "conv"

provider openai {
    api_key: env("OPENAI_API_KEY")
    model: "gpt-4o-mini"
    input_token_cost: 0.15
    output_token_cost: 0.60
}

agent Writer {
    model: openai
    system: "You are a helpful writer. Be concise."
    temperature: 0.7
}

tool get_time() -> string {
    """Returns the current time."""
    return "2024-01-01 12:00:00"
}

agent Assistant {
    model: openai
    system: "You are a helpful assistant."
    tools: [get_time]
    memory: conversation(max_turns: 5)
}

@post("/api/write")
workflow Write(prompt: string) -> { reply: string } {
    reply, err = Writer.ask(prompt)
    if err != nil {
        return { reply: "Error: " + err }
    }
    return { reply: reply }
}

@post("/api/chat")
workflow Chat(message: string, session_id: string) -> { reply: string } {
    reply, err = Assistant.ask(message, session: session_id)
    if err != nil {
        return { reply: "Error: " + err }
    }
    return { reply: reply }
}

@get("/api/stats")
workflow Stats() -> { total_cost: float, writer_cost: float, summary: map } {
    total_cost = observe.cost()
    writer_cost = observe.agent_cost("Writer")
    summary = observe.usage()
    return {
        total_cost: total_cost,
        writer_cost: writer_cost,
        summary: summary
    }
}

fn main() {
    // Enable Langfuse export (auto-detects env vars, no-op if not set)
    observe.langfuse("", "", "")

    server = http.Server([Write, Chat, Stats])
    observe.start(server)

    io.println("Server running on :8080")
    io.println("  POST /api/write")
    io.println("  POST /api/chat")
    io.println("  GET  /api/stats  (cost breakdown)")
    io.println("  UI:        http://localhost:8080/_ui/")
    io.println("  Dashboard: http://localhost:8080/_observe")
    server.listen(8080)
}
