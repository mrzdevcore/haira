// Example 33: Workflow lifecycle hooks
// Demonstrates onerror, onsuccess, and oncancel handlers in workflows.

import "io"

provider openai {
    api_key: env("OPENAI_API_KEY")
    model: "gpt-4o"
}

agent Summarizer {
    provider: openai
    system: "Summarize the given text concisely."
}

@post("/api/summarize")
workflow Summarize(text: string) -> { summary: string } {
    onerror err {
        io.println("Workflow failed: ${err}")
        return { summary: "Error: could not summarize" }
    }

    onsuccess {
        io.println("Summarization completed successfully")
    }

    step "Summarize" {
        summary, err = Summarizer.ask(text)
        if err != nil {
            return { summary: "AI error" }
        }
    }

    return { summary: summary }
}

fn main() {
    io.println("Lifecycle hooks example")
}
