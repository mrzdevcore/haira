// Async Block Demo
// Async blocks run all statements concurrently and wait for all to complete

// Simulated service calls
fetch_users() {
    sleep(200)
    print("  [User Service] User data loaded")
}

fetch_products() {
    sleep(150)
    print("  [Product Service] Product catalog ready")
}

fetch_analytics() {
    sleep(100)
    print("  [Analytics Service] Metrics collected")
}

// Simulated tasks
resize_image() {
    sleep(50)
    print("  Task 1: Image resized")
}

generate_thumbnail() {
    sleep(80)
    print("  Task 2: Thumbnail generated")
}

update_cache() {
    sleep(60)
    print("  Task 3: Cache updated")
}

// Main program
print("=== Haira Async Demo ===")
print("")

print("Fetching data from multiple sources...")
print("")

async {
    fetch_products()
    fetch_users()
    fetch_analytics()
}

print("All services responded!")
print("")

print("Processing tasks in parallel...")
async {
    resize_image()
    generate_thumbnail()
    update_cache()
}

print("")
print("=== Demo Complete ===")
