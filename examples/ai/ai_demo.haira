// AI Demo - shows AI-generated function implementations

// AI generates a function that returns 42
ai get_answer() -> int {
    Return the number 42.
}

// AI generates addition
ai add_numbers(a: int, b: int) -> int {
    Return the sum of a and b.
}

// AI generates boolean check
ai is_positive(x: int) -> bool {
    Return true if x is greater than zero, false otherwise.
}

// Main program
print("=== AI Demo ===")

answer = get_answer()
print("get_answer() =")
print(answer)

sum = add_numbers(10, 32)
print("add_numbers(10, 32) =")
print(sum)

pos = is_positive(5)
print("is_positive(5) =")
print(pos)

neg = is_positive(-3)
print("is_positive(-3) =")
print(neg)

print("=== Done ===")
