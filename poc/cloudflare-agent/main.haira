// Cloudflare AI Agent — Demonstrates Haira with Cloudflare Workers AI backend.
//
// A multi-tool research assistant powered by Cloudflare's Workers AI models.
// Showcases the `backend: "cloudflare"` provider with automatic endpoint resolution —
// no manual URL construction needed.
//
// Requires:
//   CLOUDFLARE_API_KEY    — Cloudflare API token with Workers AI permission
//   CLOUDFLARE_ACCOUNT_ID — Cloudflare account ID
//
// Run:   haira run poc/cloudflare-agent/main.haira
// Build: haira build poc/cloudflare-agent/main.haira -o cloudflare-agent
// Deploy: docker build -t cloudflare-agent poc/cloudflare-agent && docker run -p 9010:9010 cloudflare-agent

import "io"
import "http"
import "time"
import "conv"
import "string"
import "json"
import "observe"

// ---------------------------------------------------------------------------
// Provider — Cloudflare Workers AI (auto-resolved endpoint)
// ---------------------------------------------------------------------------

provider cf {
    backend: "cloudflare"
    api_key: env("CLOUDFLARE_API_KEY")
    account_id: env("CLOUDFLARE_ACCOUNT_ID")
    model: "@cf/meta/llama-3.1-70b-instruct"
}

// ---------------------------------------------------------------------------
// Tools
// ---------------------------------------------------------------------------

tool web_search(query: string) -> string {
    """
    Search the web for current information using a public search API.
    Use this when the user asks about recent events, facts, or needs up-to-date data.
    Returns a summary of search results.
    """
    encoded = http.encode_uri(query)
    resp, err = http.get("https://api.duckduckgo.com/?q=${encoded}&format=json&no_html=1")
    if err != nil {
        return "Search failed: ${err}"
    }
    data = resp.json()
    abstract = conv.to_string(data["AbstractText"])
    if abstract != "" {
        source = conv.to_string(data["AbstractSource"])
        url = conv.to_string(data["AbstractURL"])
        return "From ${source}: ${abstract}\nSource: ${url}"
    }
    // Try related topics
    topics = data["RelatedTopics"]
    if topics == nil {
        return "No results found for: ${query}"
    }
    results = ""
    count = 0
    for topic in topics {
        text = conv.to_string(topic["Text"])
        if text != "" and count < 3 {
            results = results + "- " + text + "\n"
            count = count + 1
        }
    }
    if results == "" {
        return "No results found for: ${query}"
    }
    return results
}

tool get_weather(city: string) -> string {
    """
    Get the current weather for a given city.
    Returns temperature, conditions, humidity, and wind speed.
    """
    resp, err = http.get("https://wttr.in/${city}?format=j1")
    if err != nil {
        return "Failed to fetch weather: ${err}"
    }
    data = resp.json()
    current = data["current_condition"][0]
    temp_c = current["temp_C"]
    temp_f = current["temp_F"]
    desc = current["weatherDesc"][0]["value"]
    humidity = current["humidity"]
    wind = current["windspeedKmph"]

    return ui.group(
        ui.status_card("info", "Weather: ${city}"),
        ui.key_value("Current Conditions", {
            "Temperature": "${temp_c}C / ${temp_f}F",
            "Conditions": desc,
            "Humidity": "${humidity}%",
            "Wind": "${wind} km/h"
        })
    )
}

tool calculate(expression: string) -> string {
    """
    Evaluate a mathematical expression.
    Supports basic arithmetic: +, -, *, /, parentheses.
    Example: "2 * (3 + 4)" returns "14".
    """
    // Simple expression evaluator via the math stdlib
    resp, err = http.get("https://api.mathjs.org/v4/?expr=${http.encode_uri(expression)}")
    if err != nil {
        return "Calculation error: ${err}"
    }
    return "Result: ${resp.body}"
}

tool current_time() -> string {
    """
    Get the current date and time.
    Call this when the user asks what time or date it is.
    """
    now = time.now()
    return "Current time: ${time.format(now, "2006-01-02 15:04:05 MST")}"
}

// ---------------------------------------------------------------------------
// Agent
// ---------------------------------------------------------------------------

agent ResearchAgent {
    provider: cf
    system: """
        You are a helpful research assistant powered by Cloudflare Workers AI.
        You can search the web, check weather, do calculations, and tell the time.

        RULES:
        - Be concise and helpful.
        - Use tools proactively when a user's question can benefit from real-time data.
        - For weather questions, always use the get_weather tool.
        - For factual questions about current events, use web_search.
        - For math, use calculate.
        - When tools render UI components, don't repeat the data — just add brief commentary.
    """
    tools: [web_search, get_weather, calculate, current_time]
    ui: ui
    memory: conversation(max_turns: 20)
    temperature: 0.7
    max_steps: 10
    timeout: 120
}

// ---------------------------------------------------------------------------
// Workflows
// ---------------------------------------------------------------------------

@webui(
    title: "Cloudflare AI Agent",
    description: "Research assistant powered by Cloudflare Workers AI (Llama 3.1 70B)",
    mode: "chat",
    suggestions: [
        "What's the weather in Paris?",
        "Search for the latest news about AI",
        "Calculate 15% tip on a $85 bill",
        "What time is it?"
    ],
    accent: "#F6821F",
    avatar: "C"
)
@webhook("/api/chat")
workflow Chat(message: string, session_id: string) -> stream {
    return ResearchAgent.stream(message, session: session_id)
}

@get("/api/health")
workflow Health() -> { status: string, backend: string, model: string } {
    return {
        status: "healthy",
        backend: "cloudflare",
        model: "@cf/meta/llama-3.1-70b-instruct"
    }
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

fn main() {
    io.println("Cloudflare AI Agent — Research Assistant")
    io.println("")

    if env("CLOUDFLARE_API_KEY") == "" {
        io.println("  WARNING: CLOUDFLARE_API_KEY not set")
        io.println("  Set it to enable Cloudflare Workers AI")
        io.println("")
    }
    if env("CLOUDFLARE_ACCOUNT_ID") == "" {
        io.println("  WARNING: CLOUDFLARE_ACCOUNT_ID not set")
        io.println("  Set it to enable Cloudflare Workers AI")
        io.println("")
    }

    server = http.Server([Chat, Health])
    observe.start(server)

    io.println("  Chat:     POST /api/chat (SSE)")
    io.println("  Health:   GET  /api/health")
    io.println("  UI:       http://localhost:9010/")
    io.println("  Observe:  http://localhost:9010/_observe")
    io.println("")
    io.println("  Backend:  Cloudflare Workers AI (auto-resolved)")
    io.println("  Model:    @cf/meta/llama-3.1-70b-instruct")
    io.println("")

    server.listen(9010)
}
