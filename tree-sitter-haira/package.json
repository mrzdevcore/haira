{
  "name": "tree-sitter-haira",
  "version": "1.0.0",
  "description": "Tree-sitter grammar for the Haira programming language",
  "main": "bindings/node",
  "keywords": [
    "tree-sitter",
    "parser",
    "haira"
  ],
  "author": "Haira Contributors",
  "license": "MIT",
  "dependencies": {
    "nan": "^2.18.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.22.0"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "tree-sitter": [
    {
      "scope": "source.haira",
      "file-types": [
        "haira"
      ],
      "highlights": "queries/highlights.scm"
    }
  ]
}
